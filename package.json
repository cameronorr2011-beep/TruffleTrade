{
  "name": "truffletrade",
  "version": "1.0.0",
  "private": true,
  "description": "TruffleTrade — AI stock-chart intelligence with a memory that trains itself. Six rival analysts, a fact-checker, a red team, digital-twin priors, federated learning. 1,000 sats a month, no KYC.",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "engine": "tsx engine/index.ts",
    "engine:once": "tsx engine/index.ts --once",
    "mcp": "tsx mcp/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "quote": "tsx scripts/quote-cbbtc.ts",
    "memory:update": "tsx core/memory/updater.ts",
    "verify": "tsx scripts/verify-access.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "next": "16.2.6",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.56.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
