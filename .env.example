# ── WOLFPIT configuration ──────────────────────────────────────────
# Copy to .env and fill in. Only GROQ_API_KEY is required.

# Groq (AI council brain) — required
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Engine cadence — seconds between council cycles
CYCLE_SECONDS=300

# Broker mode: paper (default) | kraken
BROKER_MODE=paper

# Paper trading starting equity in USD
PAPER_START_USD=10000

# Paper fee + slippage assumptions (bps)
PAPER_FEE_BPS=60
PAPER_SLIPPAGE_BPS=8

# Ledger location
SQLITE_PATH=data/wolfpit.sqlite3

# ── Live trading via Kraken (optional — REQUIRES KYC for US users) ──
# Kraken US requires full identity verification (SSN + ID) by federal law.
# If you have a verified account: API key with ONLY "Create & Modify Orders".
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_MAX_EXPOSURE_USD=500

# ── Degen Mode: REAL on-chain trading, self-custody, NO KYC ─────────
# Swaps USDC ⇄ cbBTC on Base via Uniswap V3 from YOUR OWN wallet.
# No exchange account exists, so no identity verification happens.
# Self-custody is legal in California. You need: a DEDICATED hot wallet
# (never your savings wallet), its USDC on Base, and ~0.001 ETH for gas.
#
# 1. BROKER_MODE=onchain          2. ONCHAIN_TRADING=1 (double lock)
# 3. ONCHAIN_PRIVATE_KEY=0x...    4. fund it, start small
# ONCHAIN_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org
WOLF_MAX_USD_PER_TRADE=50
WOLF_MAX_TOTAL_USD=100
WOLF_SLIPPAGE_BPS=100

# Kill switch: when the equity drawdown from peak exceeds this, flat & stop.
KILL_SWITCH_DD=0.15

# Optional: require x-desk-token header on /api/cycle and /api/halt
DASHBOARD_TOKEN=
