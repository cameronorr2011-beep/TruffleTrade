# ── WOLFPIT configuration ──────────────────────────────────────────
# Copy to .env and fill in. Only GROQ_API_KEY is required.

# Groq (AI council brain) — required
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Engine cadence — seconds between council cycles
CYCLE_SECONDS=300

# Broker mode: paper (default) | kraken
BROKER_MODE=paper

# Paper trading starting equity in USD
PAPER_START_USD=10000

# Paper fee + slippage assumptions (bps)
PAPER_FEE_BPS=60
PAPER_SLIPPAGE_BPS=8

# Ledger location
SQLITE_PATH=data/wolfpit.sqlite3

# ── Live trading (optional, NO KYC) ────────────────────────────────
# Create a Kraken API key with ONLY "Create & Modify Orders" enabled.
# Crypto-only Kraken accounts need no identity verification.
# Never enable withdrawal permissions on this key.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
# Hard cap in USD for live exposure. Engine refuses to exceed it.
KRAKEN_MAX_EXPOSURE_USD=500

# Kill switch: when the equity drawdown from peak exceeds this, flat & stop.
KILL_SWITCH_DD=0.15
