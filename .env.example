[TEMPLATE]
# ── TruffleTrade configuration ─────────────────────────────────────
# Copy to .env and fill in the section that matches who you are.

# ── SUBSCRIBERS: this is all you need ──────────────────────────────
# The AI runs on our gateway; you never hold an API key.
TT_GATEWAY_URL=https://truffletrade.vercel.app
TT_ACCESS_CODE=TT-XXXX-XXXX-XXXX-XXXX

# Optional: disable federated learning participation entirely.
FEDERATION_DISABLED=0

# ── OPERATOR: gateway deployment (Vercel) ──────────────────────────
# These live ONLY on the server. Never in the downloadable app.
# Groq (the AI brain behind the gateway) — most capable model:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ZBD (Lightning payments) — project apikey from https://zbd.gg
ZBD_API_KEY=

# Licensing secrets (generate: openssl rand -hex 32)
LICENSE_HMAC_KEY=
ADMIN_TOKEN=

# Postgres (production licensing store). Unset = local SQLite fallback.
DATABASE_URL=

# Public site URL (used for payment webhooks)
TT_SITE_URL=https://truffletrade.vercel.app

# Gateway fair-use rate limit per access code, per minute
GATEWAY_RATE_LIMIT_PER_MIN=60

# ── LOCAL APP ──────────────────────────────────────────────────────
# Ledger + memory databases (auto-created)
SQLITE_PATH=data/truffletrade.sqlite3
MEMORY_DB_PATH=data/memory.sqlite3

# Optional: protect mutating local endpoints (research POST, watchlist writes)
DASHBOARD_TOKEN=

# ── Engine cadence (BTC analysis desk, analysis-only) ──────────────
CYCLE_SECONDS=300
BROKER_MODE=paper
PAPER_START_USD=10000
PAPER_FEE_BPS=60
PAPER_SLIPPAGE_BPS=8
KILL_SWITCH_DD=0.15
