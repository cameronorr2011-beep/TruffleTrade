# ── TruffleTrade configuration ─────────────────────────────────────────
# Copy this file to `.env` and fill in the ONE section that matches you.
# On first run the app shows an in-app dialog for your access code —
# filling TT_ACCESS_CODE here just skips that dialog.

# ── SUBSCRIBERS: this is all you need ─────────────────────────────────
# The AI runs on our gateway; you never hold an API key.
TT_GATEWAY_URL=https://truffletrade-orr5.vercel.app


# Optional: disable federated learning participation entirely.
FEDERATION_DISABLED=0

# Optional: local port for the desktop app (default 3210).
# TT_PORT=3210

# ── OPERATOR: gateway deployment (Vercel) ─────────────────────────────
# These live ONLY on the server. Never in the downloadable app.
# Groq (the AI brain behind the gateway) — most capable model:
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Blink (Lightning payments) — RECOMMENDED, default when set.
# Free account at dashboard.blink.sv (no business KYB). Create an API key
# with Read + Receive scopes ONLY (it cannot spend). Invoices are created on
# your own Blink wallet, so sats land directly in your balance.
BLINK_API_KEY=
# Optional: pin your BTC wallet id (else auto-resolved from the account).
BLINK_WALLET_ID=
# Optional: force a flow — unset = Blink if key present, else Blockonomics,
# else ZBD, else manual.
# TT_PAYMENT_MODE=manual   # QR to your Lightning address, you approve orders
# TT_PAYMENT_MODE=zbd      # legacy ZBD charges (requires KYB + funded balance)
# TT_PAYMENT_MODE=blink    # Lightning invoices on your own Blink wallet

# Blockonomics (on-chain BTC payments) — RECOMMENDED alternative to Lightning.
# Free account at https://www.blockonomics.co (no KYB). Payments are plain
# on-chain BTC to YOUR OWN wallet (xpub) — Blockonomics never custodies funds.
# Add a BTC wallet + store in the dashboard, then paste the store's API key.
BLOCKONOMICS_API_KEY=
# Optional dedicated secret for the payment callback URL (?secret=...).
# Falls back to BLOCKONOMICS_API_KEY when unset.
BLOCKONOMICS_CALLBACK_SECRET=

# ZBD (Lightning payments) — project apikey from https://zbd.gg
ZBD_API_KEY=

# Licensing secrets (generate: openssl rand -hex 32)
LICENSE_HMAC_KEY=
ADMIN_TOKEN=

# Postgres (production licensing store). Unset = local SQLite fallback.
DATABASE_URL=

# Public site URL (used for payment webhooks)
TT_SITE_URL=https://truffletrade-orr5.vercel.app

# Gateway fair-use rate limit per access code, per minute
GATEWAY_RATE_LIMIT_PER_MIN=60

# ── LOCAL APP ─────────────────────────────────────────────────────────
# Ledger + memory databases (auto-created)
SQLITE_PATH=data/truffletrade.sqlite3
MEMORY_DB_PATH=data/memory.sqlite3

# Optional: protect mutating local endpoints (research POST, watchlist writes)
DASHBOARD_TOKEN=
